# Copy this file to `.env` and fill in your keys.
# .env is in .gitignore — NEVER commit real credentials.
#
# Get paper-trading keys from:
#   https://app.alpaca.markets/paper/dashboard/overview
# Get live-trading keys from:
#   https://app.alpaca.markets/live/dashboard/overview

ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# IMPORTANT: keep this "true" until you have validated the bot for weeks
# in paper mode and reviewed every loss. Flipping to "false" sends real orders.
PAPER_TRADING=true
